{
  "$ + math": {
    "body": "\\\\(${1:${TM_SELECTED_TEXT}}\\\\)",
    "description": "Insert inline math environment",
    "prefix": [
      "inline-math",
      "math-inline"
    ]
  },
  "T + transpose": {
    "body": "\\T{$1}",
    "prefix": [
      "T",
      "transpose"
    ]
  },
  "bi + bold-italic + mathbi": {
    "body": "\\mathbi{${1:${TM_SELECTED_TEXT}}}",
    "prefix": [
      "bi",
      "bold-italic",
      "mathbi"
    ]
  },
  "cal + mathcal": {
    "body": "\\mathcal{$1}",
    "prefix": [
      "cal",
      "mathcal"
    ]
  },
  "cos + cosinus": {
    "body": "\\cos",
    "prefix": [
      "cos",
      "cosinus"
    ]
  },
  "frac": {
    "body": "\\frac{${1:numerator}}{${2:denominator}}",
    "prefix": "frac"
  },
  "hat + chapeau": {
    "body": "\\hat{$1}",
    "prefix": [
      "hat",
      "chapeau"
    ]
  },
  "indice": {
    "body": "_{$1}",
    "prefix": "indice"
  },
  "int + integral": {
    "body": "\\int_{$1}^{$2}{$3\\d $4}",
    "prefix": [
      "int",
      "integral"
    ]
  },
  "inv + -1": {
    "body": "\\inv{$1}",
    "prefix": [
      "inv",
      "-1"
    ]
  },
  "mathbb + bb": {
    "body": "\\mathbb{$1}",
    "prefix": [
      "mathbb",
      "bb"
    ]
  },
  "mathline": {
    "body": [
      "\\[",
      "  $1",
      "\\]"
    ],
    "prefix": "mathline"
  },
  "mathrm + rm": {
    "body": "\\mathrm{$1}",
    "prefix": [
      "mathrm",
      "rm"
    ]
  },
  "pow + puissance + ^": {
    "body": "^{$1}",
    "prefix": [
      "pow",
      "puissance",
      "^"
    ]
  },
  "power + exponent": {
    "body": "^{$1}",
    "prefix": [
      "power",
      "exponent"
    ]
  },
  "prod + product + produit": {
    "body": "\\prod_{${1:i=1}}^{${2:n}}{$3}",
    "prefix": [
      "prod",
      "product",
      "produit"
    ]
  },
  "sin + sinus": {
    "body": "\\sin",
    "prefix": [
      "sin",
      "sinus"
    ]
  },
  "sqrt + squareroot + racinecarree": {
    "body": "\\sqrt{n}",
    "prefix": [
      "sqrt",
      "squareroot",
      "racinecarree"
    ]
  },
  "sum + somme": {
    "body": "\\sum_{${1:from}}^{${2:to}}{${3:of}}$0",
    "prefix": [
      "sum",
      "somme"
    ]
  },
  "tilde": {
    "body": "\\tilde{$1}",
    "prefix": "tilde"
  }
}
