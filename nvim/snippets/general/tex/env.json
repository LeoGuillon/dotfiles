{
  "(": {
    "body": "\\($1\\",
    "prefix": "("
  },
  "abstract": {
    "body": [
      "\\begin{abstract}",
      "  $0",
      "\\end{abstract}"
    ],
    "prefix": "abstract"
  },
  "alertblock": {
    "body": [
      "\\begin{alertblock}{${1:title}}",
      "  $0",
      "\\end{alertblock}"
    ],
    "prefix": "alertblock"
  },
  "align": {
    "body": [
      "\\begin{align}",
      "  $0",
      "\\end{align}"
    ],
    "prefix": "align"
  },
  "block": {
    "body": [
      "\\begin{block}{$1}",
      "  $0",
      "\\end{block}"
    ],
    "prefix": "block"
  },
  "chapter": {
    "body": [
      "\\chapter{${1:title}}\\label{chap:${2:label}}",
      "",
      "$0"
    ],
    "prefix": "chapter"
  },
  "columns-2": {
    "body": [
      "\\begin{columns}",
      "  \\begin{column}{0.5\\textwidth}",
      "    ",
      "  \\end{column}",
      "  \\begin{column}{0.5\\textwidth}",
      "    ",
      "  \\end{column}",
      "\\end{columns}"
    ],
    "prefix": "columns-2"
  },
  "definition": {
    "body": [
      "\\begin{definition}{${1:title}}{${2:label}}",
      "  ${3:definition} \\defterm{${1/(.)(.*)/${1:/downcase}${2}/}} ${5:definition}",
      "\\end{definition}"
    ],
    "prefix": "definition"
  },
  "definitionblock": {
    "body": [
      "\\begin{definitionblock}[${1:Définition}]",
      "  $0",
      "\\end{definitionblock}"
    ],
    "prefix": "definitionblock"
  },
  "description": {
    "body": [
      "\\begin{description}",
      "  \\item[$1] $2 ",
      "\\end{description}"
    ],
    "prefix": "description"
  },
  "enumerate": {
    "body": [
      "\\begin{enumerate}",
      "  \\item $1 ",
      "\\end{enumerate}"
    ],
    "prefix": "enumerate"
  },
  "env": {
    "body": [
      "\\begin{${1:env}}",
      "  $0",
      "\\end{${1:env}}"
    ],
    "prefix": [
      "begin",
      "environment"
    ]
  },
  "exampleblock": {
    "body": [
      "\\begin{exampleblock}{${1:Exemple}}",
      "  $0",
      "\\end{exampleblock}"
    ],
    "prefix": "exampleblock"
  },
  "exercise + exercice": {
    "body": [
      "\\begin{exercise}[subtitle={${1:title}}]",
      "  $0",
      "\\end{exercise}"
    ],
    "prefix": [
      "exercise",
      "exercice",
      "exo"
    ]
  },
  "figure": {
    "body": [
      "\\begin{figure}",
      "  \\centering",
      "  \\includegraphics[width=$1\\textwidth]{$2}",
      "  \\caption{$3}",
      "  \\label{fig:$2}",
      "\\end{figure}",
      "$0"
    ],
    "prefix": "figure"
  },
  "figure:tikz": {
    "body": [
      "\\begin{figure}[hb]",
      "  \\centering",
      "  \\input{src/tikz/$1}",
      "  \\caption{$2}",
      "  \\label{fig:$1}",
      "\\end{figure}",
      "$0"
    ],
    "prefix": "figure:tikz"
  },
  "itemize": {
    "body": [
      "\\begin{itemize}",
      "  \\item $0 ",
      "\\end{itemize}"
    ],
    "prefix": "itemize"
  },
  "lemma": {
    "body": [
      "\\begin{lemma}[${1:name}]\\label{lemma:${2:label}}",
      "  ${3:lemma}",
      "\\end{lemma}"
    ],
    "prefix": "lemma"
  },
  "multicols": {
    "body": [
      "\\begin{multicols}{${1:ncol}}[${2:header}]",
      "  $0",
      "\\end{multicols}"
    ],
    "prefix": "multicols"
  },
  "proof + preuve + demo": {
    "body": [
      "\\begin{proof}",
      "  $1",
      "\\end{proof}"
    ],
    "prefix": [
      "proof",
      "preuve",
      "demo"
    ]
  },
  "solution": {
    "body": [
      "\\begin{solution}",
      "  $0",
      "\\end{solution}"
    ],
    "prefix": "solution"
  },
  "table-input": {
    "body": [
      "\\begin{table}",
      "  \\centering",
      "  \\input{src/tables/$1}",
      "  \\caption{$2}",
      "  \\label{tab:${1/(.+?)(tex)?/$1/}}",
      "\\end{table}",
      "$0"
    ],
    "prefix": "table"
  },
  "theorem": {
    "body": [
      "\\begin{theorem}{${1:name}}{${2:label}}",
      "  ${3:${TM_SELECTED_TEXT}}",
      "\\end{theorem}"
    ],
    "prefix": "theorem"
  },
  "verbatim": {
    "body": [
      "\\begin{verbatim}",
      "  $0",
      "\\end{verbatim}"
    ],
    "prefix": "verbatim"
  }
}